# ─── Core ────────────────────────────────────────────────
API_PORT=3001
MQTT_URL=mqtt://localhost:1883
DB_PATH=./data/maisie.db
LAN_IP=                    # IP address of this Maisie host on your LAN

# ─── AI Provider ─────────────────────────────────────────
ANTHROPIC_API_KEY=
AI_PROVIDER=anthropic      # anthropic | openai | ollama
AI_MODEL=                  # optional, uses provider default
OPENAI_API_KEY=            # if AI_PROVIDER=openai
OLLAMA_HOST=               # if AI_PROVIDER=ollama, e.g. http://localhost:11434

# ─── Domain / TLS ────────────────────────────────────────
DOMAIN=                    # your domain, e.g. home.example.com
CERTS_DIR=                 # optional override; defaults to ~/certs/config/live/${DOMAIN}
ROUTE53_ZONE_ID=           # Route 53 hosted zone ID (for DDNS update script)

# ─── Network — UniFi ─────────────────────────────────────
UNIFI_HOST=
UNIFI_USERNAME=
UNIFI_PASSWORD=
UNIFI_SSH_PASSWORD=        # for cert deployment to UDM Pro via SSH
UNIFI_SITE=default
UNIFI_PROTECT_ENABLED=false
UNIFI_IOT_NETWORK_ID=      # UniFi network ID for IoT VLAN (for allow-iot-to-ha script)

# ─── Media — Plex ────────────────────────────────────────
PLEX_HOST=
PLEX_PORT=32400
PLEX_TOKEN=
PLEX_MOVIES_PATH=          # comma-separated paths to movie libraries
PLEX_TV_PATH=              # comma-separated paths to TV libraries
PLEX_PATH_PREFIX=          # Plex container path prefix, e.g. /volume1/PlexLibrary
PLEX_DB_PATH=              # path to Plex sqlite DB (for plex-convert.sh)
PLEX_HOST_PREFIX=          # host path prefix for Plex media (for plex-convert.sh)

# ─── Media — Radarr / Sonarr / Readarr / Prowlarr ────────
RADARR_HOST=
RADARR_PORT=7878
RADARR_API_KEY=
RADARR_URL_BASE=
SONARR_HOST=
SONARR_PORT=8989
SONARR_API_KEY=
SONARR_URL_BASE=
READARR_HOST=
READARR_PORT=8787
READARR_API_KEY=
READARR_URL_BASE=
PROWLARR_HOST=
PROWLARR_PORT=9696
PROWLARR_API_KEY=
PROWLARR_URL_BASE=

# ─── Storage — Synology ───────────────────────────────────
SYNOLOGY_HOST=
SYNOLOGY_PORT=5001
SYNOLOGY_USERNAME=
SYNOLOGY_PASSWORD=
SYNOLOGY_SSH_PORT=22
SYNOLOGY_HTTPS=true
MEDIA_PATH=                # path to NAS media mount, e.g. /mnt/nas/plex-library

# ─── Smart Home — Home Assistant ─────────────────────────
HA_HOST=
HA_PORT=8123
HA_TOKEN=

# ─── Books — Calibre ─────────────────────────────────────
CALIBRE_HOST=
CALIBRE_PORT=8081
CALIBRE_CONTAINER_NAME=calibre
CALIBRE_LIBRARY_PATH=/config/Calibre Library

# ─── Google OAuth2 (Gmail / Calendar / YouTube) ──────────
# Create credentials at https://console.cloud.google.com → APIs & Services → Credentials
# Enable: Gmail API, Google Calendar API, YouTube Data API v3
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/google/callback

# ─── Printer — Bambu Lab ─────────────────────────────────
BAMBU_HOST=
BAMBU_SERIAL=
BAMBU_ACCESS_CODE=

# ─── TV / HDHomeRun ──────────────────────────────────────
HDHR_HOST=                 # real HDHomeRun PRIME host IP

# ─── Streaming — Internal Services ───────────────────────
TOKYO_STREAMER_URL=http://localhost:5050
GO2RTC_URL=http://localhost:1984
GO2RTC_RTSP=rtsp://localhost:8554
SYNTHETIC_HDHR_URL=http://localhost:5004

# ─── Transmission ────────────────────────────────────────
TRANSMISSION_HOST=
TRANSMISSION_PORT=9091
TRANSMISSION_USERNAME=
TRANSMISSION_PASSWORD=
TRANSMISSION_DATA=         # path to transmission data dir

# ─── Display — DAKboard ──────────────────────────────────
DAKBOARD_API_KEY=

# ─── Gaming — PS4 ────────────────────────────────────────
PS4_HOST=
PS4_FTP_PORT=21

# ─── Maintenance / HEVC conversion ───────────────────────
NIGHTLY_START_HOUR=23
NIGHTLY_END_HOUR=5
HEVC_ENABLED=false
HEVC_QUEUE_PATH=           # path to HEVC conversion queue file
RADARR_CONTAINER_NAME=radarr

# ─── Misc ─────────────────────────────────────────────────
AA_API_KEY=                # Anna's Archive API key (for book search enrichment)
MAISIE_HOST=               # LAN IP of this host (used by plex-dvr-surgery.sh)
