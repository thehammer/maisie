{
  "name": "@maisie/agent",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "NODE_TLS_REJECT_UNAUTHORIZED=0 bun run --watch src/index.ts",
    "start": "NODE_TLS_REJECT_UNAUTHORIZED=0 bun run src/index.ts",
    "test": "bun test",
    "lint": "tsc --noEmit",
